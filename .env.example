# ========================================================
# FolioShield Environment Configuration
# Copy to .env and fill in. Never commit real keys.
# ========================================================

# Model Provider: groq, together, openrouter, or mock (offline template mode — default)
LLAMA_PROVIDER=mock

# Each provider reads ONLY its own key.
# Groq API Key (fast Meta Llama inference): https://console.groq.com/
GROQ_API_KEY=

# Together AI Key (optional): https://api.together.xyz/
TOGETHER_API_KEY=

# OpenRouter Key (optional): https://openrouter.ai/
OPENROUTER_API_KEY=

# Optional model overrides (leave blank to use each provider's default)
LLAMA_TEXT_MODEL=
LLAMA_VISION_MODEL=

# Merchant name used when an uploaded folio does not contain one
FOLIOSHIELD_MERCHANT_NAME=Grand Horizon Resort & Suites
