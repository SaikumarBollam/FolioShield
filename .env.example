# ==============================================================================
# FolioShield Environment Configuration
# Copy this file to '.env' and adjust variables for your target environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT SELECTOR
# Options: 'production', 'testing', or 'development'
#   - 'testing': enables scenario quick-loader, offline mock, and debug details
#   - 'production': enforces live intake, hides mock data, and strict audit logging
# ------------------------------------------------------------------------------
ENVIRONMENT=testing

# ------------------------------------------------------------------------------
# 2. AI MODEL & INFERENCE PROVIDER
# Options: 'groq' (recommended for Meta Llama), 'together', 'openrouter', or 'mock' (offline)
# In testing mode, 'mock' runs offline tests with zero API keys required.
# ------------------------------------------------------------------------------
LLAMA_PROVIDER=mock

# Groq API Key (Fast Meta Llama inference — https://console.groq.com/)
GROQ_API_KEY=

# Together AI Key (Optional — https://api.together.xyz/)
TOGETHER_API_KEY=

# OpenRouter Key (Optional — https://openrouter.ai/)
OPENROUTER_API_KEY=

# Model Overrides (leave blank to use each provider's official Meta Llama default)
LLAMA_TEXT_MODEL=
LLAMA_VISION_MODEL=

# ------------------------------------------------------------------------------
# 3. HOTEL & MERCHANT PROFILE
# ------------------------------------------------------------------------------
FOLIOSHIELD_MERCHANT_NAME=Grand Horizon Resort & Suites
HOTEL_CONTACT_EMAIL=disputes@grandhorizonresort.com

# ------------------------------------------------------------------------------
# 4. OPERATIONAL FEATURE FLAGS & SWITCHES
# Toggle test scenarios in the UI (true for QA/testing, false for production intake)
# ------------------------------------------------------------------------------
ENABLE_TEST_SCENARIOS=true

# Show raw JSON & debug text expanders (true for QA/testing, false for clean staff view)
SHOW_DEBUG_DETAILS=true

# Maximum file upload size in Megabytes (default: 10)
MAX_UPLOAD_SIZE_MB=10

# API Request Timeout in seconds
REQUEST_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# 5. LOGGING & AUDIT TRAIL
# ------------------------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO

# Optional HMAC key for tamper-evident audit event hashes (use a secret manager)
AUDIT_HMAC_KEY=

# ------------------------------------------------------------------------------
# 6. ENTERPRISE INTEGRATIONS (API / Agent / Embedded)
# ------------------------------------------------------------------------------
# Tenant integration registry storage root
FOLIOSHIELD_INTEGRATION_ROOT=data/integrations

# API controls (built-in server remains for development/controlled testing;
# production requires TLS termination and network controls)
FOLIOSHIELD_API_CORS_ORIGINS=http://localhost:8501,http://localhost:3000
FOLIOSHIELD_API_MAX_BODY_MB=15
API_PORT=8000

# Embedded mode (signed context; secret stays server-side, never in browser code)
FOLIOSHIELD_EMBEDDED_ENABLED=false
FOLIOSHIELD_EMBEDDED_SECRET=
FOLIOSHIELD_EMBEDDED_ALLOWED_ORIGINS=
FOLIOSHIELD_EMBEDDED_DEFAULT_VIEW=dashboard

# Connector Agent credential (agent machine only; prefer a restricted credential file)
FOLIOSHIELD_AGENT_API_KEY=
