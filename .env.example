# ==============================================================================
# FolioShield Environment Configuration
# Copy this file to '.env' and adjust variables for your target environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT SELECTOR
# Options: 'production', 'testing', or 'development'
#   - 'testing': enables scenario quick-loader, offline mock, and debug details
#   - 'production': enforces live intake, hides mock data, and strict audit logging
# ------------------------------------------------------------------------------
ENVIRONMENT=testing

# ------------------------------------------------------------------------------
# 2. AI MODEL & INFERENCE PROVIDER
# Options: 'groq' (recommended for Meta Llama), 'together', 'openrouter', or 'mock' (offline)
# In testing mode, 'mock' runs offline tests with zero API keys required.
# ------------------------------------------------------------------------------
LLAMA_PROVIDER=mock

# Groq API Key (Fast Meta Llama inference — https://console.groq.com/)
GROQ_API_KEY=

# Together AI Key (Optional — https://api.together.xyz/)
TOGETHER_API_KEY=

# OpenRouter Key (Optional — https://openrouter.ai/)
OPENROUTER_API_KEY=

# Model Overrides (leave blank to use each provider's official Meta Llama default)
LLAMA_TEXT_MODEL=
LLAMA_VISION_MODEL=

# ------------------------------------------------------------------------------
# 3. HOTEL & MERCHANT PROFILE
# ------------------------------------------------------------------------------
FOLIOSHIELD_MERCHANT_NAME=Grand Horizon Resort & Suites
HOTEL_CONTACT_EMAIL=disputes@grandhorizonresort.com

# ------------------------------------------------------------------------------
# 4. OPERATIONAL FEATURE FLAGS & SWITCHES
# Toggle test scenarios in the UI (true for QA/testing, false for production intake)
# ------------------------------------------------------------------------------
ENABLE_TEST_SCENARIOS=true

# Show raw JSON & debug text expanders (true for QA/testing, false for clean staff view)
SHOW_DEBUG_DETAILS=true

# Maximum file upload size in Megabytes (default: 10)
MAX_UPLOAD_SIZE_MB=10

# API Request Timeout in seconds
REQUEST_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# 5. LOGGING & AUDIT TRAIL
# ------------------------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO

# Persistent exhibit store: collected evidence files are retained here,
# content-addressed by SHA-256, so exhibits survive restarts and can be
# bundled for submission. Back this directory up with your case data.
FOLIOSHIELD_EXHIBIT_DIR=data/exhibits

# Durable case database (SQLite): case + evidence metadata so cases
# survive restarts and can be reopened from the sidebar.
FOLIOSHIELD_CASE_DB=data/cases.db

# --- REST API protection (Phase 1 P0) ---
# Shared key for the legacy /api/v1/* endpoints. When set, every
# non-health endpoint requires: Authorization: Bearer <key>
FOLIOSHIELD_API_KEY=
# Allow legacy endpoints without a key (local development only).
# Default: allowed outside production, denied in production.
# FOLIOSHIELD_API_ALLOW_LEGACY_UNAUTHENTICATED=true
FOLIOSHIELD_API_RATE_LIMIT_PER_MIN=120
FOLIOSHIELD_API_HOST=0.0.0.0

# --- Webhook secrets & delivery (Phase 2 P1) ---
# Fernet key used to encrypt webhook signing secrets at rest. When unset,
# a key is generated at <integration root>/webhook_secret.key. Losing the
# key makes stored secrets unrecoverable (subscriptions must rotate).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FOLIOSHIELD_WEBHOOK_SECRET_KEY=
# Seconds between webhook retry-resume cycles in the API server (0 = off;
# retries can also be resumed by the agent or a cron calling the manager).
FOLIOSHIELD_WEBHOOK_RESUME_SECONDS=0

# Optional HMAC key for tamper-evident audit event hashes (use a secret manager)
AUDIT_HMAC_KEY=

# ------------------------------------------------------------------------------
# 6. ENTERPRISE INTEGRATIONS (API / Agent / Embedded)
# ------------------------------------------------------------------------------
# Tenant integration registry storage root
FOLIOSHIELD_INTEGRATION_ROOT=data/integrations

# API controls (built-in server remains for development/controlled testing;
# production requires TLS termination and network controls)
FOLIOSHIELD_API_CORS_ORIGINS=http://localhost:8501,http://localhost:3000
FOLIOSHIELD_API_MAX_BODY_MB=15
API_PORT=8000

# Embedded mode (signed context; secret stays server-side, never in browser code)
FOLIOSHIELD_EMBEDDED_ENABLED=false
FOLIOSHIELD_EMBEDDED_SECRET=
FOLIOSHIELD_EMBEDDED_ALLOWED_ORIGINS=
FOLIOSHIELD_EMBEDDED_DEFAULT_VIEW=dashboard

# Host theme defaults (optional; signed embedded context theme overrides these.
# Leave blank to keep the FolioShield default theme.)
FOLIOSHIELD_THEME_PRIMARY_COLOR=
FOLIOSHIELD_THEME_ACCENT_COLOR=
FOLIOSHIELD_THEME_BACKGROUND_COLOR=
FOLIOSHIELD_THEME_TEXT_COLOR=
FOLIOSHIELD_THEME_FONT_FAMILY=
FOLIOSHIELD_THEME_BRAND_NAME=
FOLIOSHIELD_THEME_LOGO_URL=

# Connector Agent credential (agent machine only; prefer a restricted credential file)
FOLIOSHIELD_AGENT_API_KEY=

# ------------------------------------------------------------------------------
# 7. RELATIONAL DATABASE & OBJECT STORAGE
# ------------------------------------------------------------------------------
# PostgreSQL database URL for commercial multi-tenant persistence:
# DATABASE_URL=postgresql://folioshield:folioshield@localhost:5432/folioshield
DATABASE_URL=

# S3-compatible Object Storage for durable evidence exhibits (AWS S3, MinIO, R2):
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET_NAME=folioshield-exhibits
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
